{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crush.platform/contracts/v1/claim-event.schema.json",
  "title": "CRUSH ClaimEvent",
  "description": "Canonical pre-payment claim event. Identifiers are submitted values; resolution IDs are optional and must never be substituted by raw identifiers downstream.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id", "tenant_id", "program", "source_system", "source_message_id",
    "claim_control_number", "claim_type", "received_at", "billing_provider",
    "beneficiary", "service_period", "lines", "total_billed", "raw_ref",
    "ingest_quality", "schema_version"
  ],
  "properties": {
    "event_id": {"type": "string", "pattern": "^evt_[A-Za-z0-9_-]{8,}$"},
    "tenant_id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{2,62}$"},
    "program": {"enum": ["MEDICARE_FFS", "MA", "PART_D", "MEDICAID", "CHIP", "MARKETPLACE"]},
    "source_system": {"type": "string", "minLength": 1, "maxLength": 100},
    "source_message_id": {"type": "string", "minLength": 1, "maxLength": 255},
    "claim_control_number": {"type": "string", "minLength": 1, "maxLength": 100},
    "claim_type": {"enum": ["INSTITUTIONAL", "PROFESSIONAL", "DENTAL", "PHARMACY", "ENCOUNTER"]},
    "received_at": {"type": "string", "format": "date-time"},
    "billing_provider": {"$ref": "#/$defs/providerRef"},
    "rendering_provider": {"anyOf": [{"$ref": "#/$defs/providerRef"}, {"type": "null"}]},
    "beneficiary": {"$ref": "#/$defs/beneficiaryRef"},
    "service_period": {
      "type": "object", "additionalProperties": false, "required": ["start"],
      "properties": {"start": {"type": "string", "format": "date"}, "end": {"type": ["string", "null"], "format": "date"}}
    },
    "lines": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/claimLine"}},
    "total_billed": {"type": "number", "minimum": 0},
    "raw_ref": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "ingest_quality": {"type": "object", "additionalProperties": {"type": "string"}},
    "schema_version": {"type": "string", "pattern": "^1\\.[0-9]+\\.[0-9]+$"}
  },
  "$defs": {
    "providerRef": {
      "type": "object", "additionalProperties": false,
      "required": ["submitted_npi"],
      "properties": {
        "submitted_npi": {"type": "string", "pattern": "^[0-9]{10}$"},
        "resolved_uid": {"type": ["string", "null"], "pattern": "^pr_[A-Za-z0-9_-]{8,}$"},
        "location": {"$ref": "#/$defs/point"}
      }
    },
    "beneficiaryRef": {
      "type": "object", "additionalProperties": false,
      "required": ["submitted_id_hash"],
      "properties": {
        "submitted_id_hash": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
        "resolved_uid": {"type": ["string", "null"], "pattern": "^bn_[A-Za-z0-9_-]{8,}$"},
        "date_of_death": {"type": ["string", "null"], "format": "date"}
      }
    },
    "point": {
      "type": "object", "additionalProperties": false,
      "required": ["latitude", "longitude", "precision_m"],
      "properties": {
        "latitude": {"type": "number", "minimum": -90, "maximum": 90},
        "longitude": {"type": "number", "minimum": -180, "maximum": 180},
        "precision_m": {"type": "number", "minimum": 0}
      }
    },
    "claimLine": {
      "type": "object", "additionalProperties": false,
      "required": ["line_number", "service_date", "billed_amount"],
      "properties": {
        "line_number": {"type": "integer", "minimum": 1},
        "service_date": {"type": "string", "format": "date"},
        "hcpcs_cpt": {"type": ["string", "null"], "maxLength": 16},
        "units": {"type": "number", "exclusiveMinimum": 0},
        "billed_amount": {"type": "number", "minimum": 0},
        "order_date": {"type": ["string", "null"], "format": "date"},
        "delivery_date": {"type": ["string", "null"], "format": "date"},
        "service_location": {"$ref": "#/$defs/point"}
      }
    }
  }
}
