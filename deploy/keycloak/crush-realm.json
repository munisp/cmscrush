{
  "realm": "crush",
  "enabled": true,
  "displayName": "CRUSH Integrity Platform",
  "sslRequired": "all",
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "roles": {
    "realm": [
      {"name": "investigator"},
      {"name": "medical-coder"},
      {"name": "payment-operations"},
      {"name": "adjudicator"},
      {"name": "compliance-officer"},
      {"name": "platform-service"}
    ]
  },
  "clients": [
    {
      "clientId": "crush-api",
      "enabled": true,
      "publicClient": false,
      "protocol": "openid-connect",
      "standardFlowEnabled": true,
      "serviceAccountsEnabled": true,
      "redirectUris": ["https://crush.example.invalid/*"],
      "defaultClientScopes": ["profile", "email", "crush-context"],
      "protocolMappers": [
        {
          "name": "tenant claim",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {"user.attribute": "crush_tenant", "claim.name": "crush_tenant", "jsonType.label": "String", "access.token.claim": "true", "id.token.claim": "true", "userinfo.token.claim": "true"}
        },
        {
          "name": "purpose of use claim",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {"user.attribute": "purpose_of_use", "claim.name": "purpose_of_use", "jsonType.label": "String", "access.token.claim": "true", "id.token.claim": "true", "userinfo.token.claim": "true"}
        },
        {
          "name": "programme claim",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {"user.attribute": "program", "claim.name": "program", "jsonType.label": "String", "access.token.claim": "true", "id.token.claim": "true", "userinfo.token.claim": "true"}
        }
      ]
    }
  ],
  "clientScopes": [
    {"name": "crush-context", "protocol": "openid-connect", "attributes": {"include.in.token.scope": "true"}}
  ]
}
